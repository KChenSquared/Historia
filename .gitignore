# ====================================================================
# .gitignore for Historia (.NET / Avalonia UI / Visual Studio / VS Code / Rider)
# ====================================================================

# --------------------------------------------------------------------
# Nested repos (own their own history, not tracked here)
# --------------------------------------------------------------------
/Historia-DevDocs/

# --------------------------------------------------------------------
# Build Results & Artifacts
# --------------------------------------------------------------------
[Bb]in/
[Oo]bj/
# Scratch build outputs used to compile-check while the app holds a lock on bin/
*-verify/
*-verify-int/
[Aa]rtifacts/
.artifacts/
[Oo]ut/
# Bundled Git updater: Python bytecode and the pull request body it writes
__pycache__/
/bundled-git-pr-body.md
[Bb]ld/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
dist/
Generated\ Files/
*_wpftmp.csproj

# MSBuild Logs & Binary Logs
*.binlog
*.log
*.tlog
[Bb]uild[Ll]og.*
MSBuild_Logs/

# --------------------------------------------------------------------
# WebView2 Cache & Runtime User Data
# --------------------------------------------------------------------
*.WebView2/
[Ee][Bb][Ww]eb[Vv]iew/
EBWebView/
*.VisualElementsManifest.xml

# --------------------------------------------------------------------
# Test & Benchmark Results
# --------------------------------------------------------------------
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
BenchmarkDotNet.Artifacts/

# --------------------------------------------------------------------
# User-Specific & Environment Files
# --------------------------------------------------------------------
*.user
*.userosscache
*.suo
*.userprefs
*.rsuser
*.sln.docstates
*.env
*.env.*
!.env.example

# --------------------------------------------------------------------
# IDE & Editor Directories
# --------------------------------------------------------------------

# Visual Studio
.vs/
*.VC.db
*.VC.VC.opendb
*.opendb
*.opensdf
*.sdf
*.pidb
*.vsp
*.vspx
*.sap
*.psess

# JetBrains Rider / ReSharper
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

# --------------------------------------------------------------------
# NuGet Packages & Restore Artifacts
# --------------------------------------------------------------------
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# --------------------------------------------------------------------
# Operating System & Temporary Files
# --------------------------------------------------------------------
# Editor / tooling backups
*.bak

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.dmp
*.mdmp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# --------------------------------------------------------------------
# Node / Frontend (if tooling added later)
# --------------------------------------------------------------------
node_modules/
.npm/
.yarn/

# --------------------------------------------------------------------
# Dev Tooling Reports
# --------------------------------------------------------------------
/dev/loc-report.md

# Local Claude Code instructions
/CLAUDE.local.md
