#!/bin/sh
# Refuses to push a v* tag whose commit has no release notes file.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# git feeds one line per updated ref on standard input:
#   <local ref> <local object> <remote ref> <remote object>
# Only the local object and the remote ref are used. The notes file is read from the pushed object (an annotated or lightweight tag peels to its
# commit's tree), never from the working tree. Deleting a tag is always allowed.
set -eu

failed=0

while read -r _ local_sha remote_ref _; do
    case "$remote_ref" in
        refs/tags/v*) ;;
        *) continue ;;
    esac

    # An all-zero object name (any hash length) means the ref is being deleted.
    if [ -z "$(printf '%s' "$local_sha" | tr -d '0')" ]; then
        continue
    fi

    tag="${remote_ref#refs/tags/}"
    notes="docs/release-notes/$tag.md"

    if ! git cat-file -e "$local_sha:$notes" 2>/dev/null; then
        echo "pre-push: refusing to push tag $tag: the tagged commit has no $notes" >&2
        failed=1
    fi
done

if [ "$failed" -ne 0 ]; then
    echo "pre-push: add the notes file, merge it, then delete and re-create the tag." >&2
    exit 1
fi

exit 0
