<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theming="using:Historia.Theming"
             x:Class="Historia.App"
             RequestedThemeVariant="Dark">
    <!-- the palette (ColorBg, ColorBorder, …) is generated from HistoriaPalette at runtime
         by AvaloniaThemeApplier and merged into Application.Resources — not authored here, so
         the one source of truth stays HistoriaPalette.cs. -->
    <Application.Resources>
        <ControlTheme x:Key="ScrollBarPageButtonTheme" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="ScrollBarThumbTheme" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackgroundColor}" />
            <Setter Property="CornerRadius" Value="{x:Static theming:ScrollBarMetrics.ThumbCornerRadius}" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPointerOver}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPressed}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />

            <Style Selector="^:vertical">
                <Setter Property="MinWidth" Value="{x:Static theming:ScrollBarMetrics.Lane}" />
                <Setter Property="Width" Value="{x:Static theming:ScrollBarMetrics.Lane}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent" UseLayoutRounding="False">
                            <Track Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_PageUpButton"
                                                  Theme="{StaticResource ScrollBarPageButtonTheme}" />
                                </Track.DecreaseButton>
                                <Track.Thumb>
                                    <Thumb Width="{x:Static theming:ScrollBarMetrics.Thumb}"
                                           MinHeight="{x:Static theming:ScrollBarMetrics.ThumbMinLength}"
                                           HorizontalAlignment="Center"
                                           Theme="{StaticResource ScrollBarThumbTheme}" />
                                </Track.Thumb>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_PageDownButton"
                                                  Theme="{StaticResource ScrollBarPageButtonTheme}" />
                                </Track.IncreaseButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </Style>

            <Style Selector="^:horizontal">
                <Setter Property="MinHeight" Value="{x:Static theming:ScrollBarMetrics.Lane}" />
                <Setter Property="Height" Value="{x:Static theming:ScrollBarMetrics.Lane}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent" UseLayoutRounding="False">
                            <Track Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="False">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_PageUpButton"
                                                  Theme="{StaticResource ScrollBarPageButtonTheme}" />
                                </Track.DecreaseButton>
                                <Track.Thumb>
                                    <Thumb Height="{x:Static theming:ScrollBarMetrics.Thumb}"
                                           MinWidth="{x:Static theming:ScrollBarMetrics.ThumbMinLength}"
                                           VerticalAlignment="Center"
                                           Theme="{StaticResource ScrollBarThumbTheme}" />
                                </Track.Thumb>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_PageDownButton"
                                                  Theme="{StaticResource ScrollBarPageButtonTheme}" />
                                </Track.IncreaseButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </Style>
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- a classless Button never shows Fluent's grey fill. It reads like the Clone
             dialog's buttons — transparent ground, 1 px outline, plain text — and only paints a
             subtle fill on hover / press. Anything that opts into .primary / .flat / .danger /
             .success / .secondary keeps its own chrome (class selectors outrank this one).
             Icon buttons that set Background / BorderThickness inline stay borderless (a local
             value outranks a style), they just lose the grey hover box. -->
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderStrong}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
        </Style>

        <!-- Flat button family: understated chrome, quiet disabled state.
             At rest the fill matches the panel background (transparent) with a grey outline;
             only hover paints a fill. -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderStrong}" />
        </Style>
        <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
        </Style>
        <Style Selector="Button.secondary:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource ColorPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorPrimaryHover}" />
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- The sidebar toggle's unseen-count circle. At rest it is a surface chip with muted
             text; with unseen items it takes the primary button's colours on either toggle half;
             on the active (primary) half it gains a ring in the primary button's foreground so it
             stays visible against the button, and at 0 unseen its fill clears. The white lives
             here, beside Button.primary, because the view markup is kept on palette keys. -->
        <Style Selector="Border.cmdr-count">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="5,0" />
        </Style>
        <Style Selector="Border.cmdr-count > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.cmdr-count.unseen">
            <Setter Property="Background" Value="{DynamicResource ColorPrimary}" />
        </Style>
        <Style Selector="Border.cmdr-count.unseen > TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.cmdr-count.on-active">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.cmdr-count.on-active.unseen">
            <Setter Property="Background" Value="{DynamicResource ColorPrimary}" />
        </Style>
        <Style Selector="Border.cmdr-count.on-active > TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Icon/arrow chrome buttons: no fill until hover. When disabled the glyph fades but the
             ground stays flush with the enabled sibling (Fluent's disabled ContentPresenter paints
             a grey box otherwise), so a disabled arrow reads as the same black with a fainter mark. -->

        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
        </Style>
        <Style Selector="Button.flat:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorSurface2}" />
        </Style>
        <Style Selector="Button.flat:disabled">
            <Setter Property="Opacity" Value="0.28" />
        </Style>
        <Style Selector="Button.flat:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorDanger}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorDanger}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorDanger}" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorSurface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorDanger}" />
        </Style>
        <Style Selector="Button.danger:disabled">
            <Setter Property="Opacity" Value="0.28" />
        </Style>
        <Style Selector="Button.danger:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorDanger}" />
        </Style>

        <Style Selector="Button.success">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorSuccess}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorSuccess}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.success:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorSuccess}" />
        </Style>
        <Style Selector="Button.success:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorSurface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorSuccess}" />
        </Style>
        <Style Selector="Button.success:disabled">
            <Setter Property="Opacity" Value="0.28" />
        </Style>
        <Style Selector="Button.success:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorSuccess}" />
        </Style>
        <Style Selector="RepeatButton.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="RepeatButton.flat:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
        </Style>
        <Style Selector="RepeatButton.flat:disabled">
            <Setter Property="Opacity" Value="0.28" />
        </Style>
        <Style Selector="RepeatButton.flat:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Global quiet-disabled net: Fluent paints a grey fill on the ContentPresenter of any
             :disabled button that hasn't opted into its own chrome above. Blank just that fill
             (leave the border alone) so a disabled button keeps the same ground as its enabled
             sibling and only the glyph/label fades — the Discard-all behaviour, everywhere. -->
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="RepeatButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Menu, ContextMenu & Flyout theming -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Menu">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- MenuItem / ToolTip colours (every state) come from the Fluent resource
             keys AvaloniaThemeApplier overrides; only geometry the keys can't express is styled
             here, so no per-instance pseudo-class / template selectors are added. -->
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource ColorBorder}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <!-- ToolTip theming -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- The scrollbar always shows and owns its lane, so content is never laid out under it. -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>

        <StyleInclude Source="avares://Historia/Views/Styles/ViewStyles.axaml" />
    </Application.Styles>
</Application>
