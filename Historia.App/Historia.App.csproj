<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Historia</RootNamespace>
    <!-- Executable name: compiled binary ships as Historia.exe (Historia on macOS/Linux).
         RootNamespace is Historia. avares:// assembly authority matches this name. -->
    <AssemblyName>Historia</AssemblyName>
    <!-- Views take their services through constructors and are created from code, never by the runtime loader. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Framework-dependent. Windows is the parity target;
         macOS / Linux must compile and launch. -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64;linux-x64</RuntimeIdentifiers>
    <ApplicationIcon>Historia.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release publishes ship ReadyToRun images (precompiled native code beside the IL) so startup
       skips most JIT work. Needs a runtime identifier; the build stays framework-dependent, so the
       package gains no runtime prerequisite. Debug builds and plain builds are unaffected. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned, no floating wildcard. -->
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="11.4.1" />
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Historia.Core\Historia.Core.csproj" />
    <!-- historia-cmdr.exe is built into this output folder so it sits beside Historia.exe. -->
    <ProjectReference Include="..\Historia.Cmdr\Historia.Cmdr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Headless-Avalonia regression suite. Mirrors the Historia.Core → Historia.Tests
         grant; the helpers it tests are internal. -->
    <InternalsVisibleTo Include="Historia.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Launch splashes authored under assets/ (dev/build-splash.ps1), embedded as avares. -->
    <AvaloniaResource Include="..\assets\splash-light.png" Link="Assets\splash-light.png" />
    <AvaloniaResource Include="..\assets\splash-dark.png" Link="Assets\splash-dark.png" />
  </ItemGroup>

  <!-- Dev-mode marker: copied next to the exe on every build so the Developer menu entry
       appears, but never included in a publish / release package. -->
  <ItemGroup>
    <None Include="..\dev\enableDevMode" Link="enableDevMode">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\docs\third-party-licenses.md" Link="third-party-licenses.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
