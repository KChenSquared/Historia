<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Ships as historia-cmdr.exe beside Historia.exe. A console program, because Historia.exe
         is a WinExe: shells do not wait for it and its output is not attached, so an agent could
         read neither a result nor an exit code from it. The lower-case hyphenated name also keeps it
         clear of Historia.exe on case-insensitive file systems. -->
    <AssemblyName>historia-cmdr</AssemblyName>
    <RootNamespace>Historia.Cmdr</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Release publishes ship ReadyToRun images so a short-lived CLI call skips most JIT work. Needs a
       runtime identifier; the build stays framework-dependent, so there is no new runtime prerequisite. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Historia.Core\Historia.Core.csproj" />
  </ItemGroup>

</Project>
